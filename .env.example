# Copy to .env.local for local development.
# In production, set these in the Vercel project settings (Settings → Environment Variables).
# .env.local is git-ignored — never commit a real key.

ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# Swap to claude-sonnet-5 or claude-haiku-4-5 to trade quality for cost.
ANTHROPIC_MODEL=claude-opus-5

# Optional. Absolute base URL used for social share-card links.
# Vercel injects VERCEL_URL automatically per deployment; set this once you
# attach a custom domain so cards point at the canonical host.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form (POST /api/contact) ---
# Two independent sinks. Configure either or both; with neither, the form
# renders but returns 503 telling visitors to email directly.

# 1) Google Sheets — every submission appended as a row with the exact
#    date/time. Setup instructions are in scripts/google-sheets-webhook.gs.
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/..../exec
# GOOGLE_SHEETS_SECRET=<same string as SHARED_SECRET in the Apps Script>

# 2) Email via Resend (https://resend.com — free tier 3,000/month).
# RESEND_API_KEY=re_...
# CONTACT_TO=knvdurgaprasad3009@gmail.com
# CONTACT_FROM=Portfolio <onboarding@resend.dev>
