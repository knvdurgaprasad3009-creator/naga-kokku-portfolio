# Copy to .env.local for local development.
# In production, set these in the Vercel project settings (Settings → Environment Variables).
# .env.local is git-ignored — never commit a real key.

ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# Swap to claude-sonnet-5 or claude-haiku-4-5 to trade quality for cost.
ANTHROPIC_MODEL=claude-opus-5

# Optional. Absolute base URL used for social share-card links.
# Vercel injects VERCEL_URL automatically per deployment; set this once you
# attach a custom domain so cards point at the canonical host.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
